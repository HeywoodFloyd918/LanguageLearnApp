<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Как меняются слова в иврите"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Шпаргалка: прилагательные и глаголы меняются по роду и числу — как и в русском."
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- ============= КАРТОЧКА 1: МЕСТОИМЕНИЯ ============= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Местоимения"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Эти слова определяют род и число."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout style="@style/GrammarRow">
                        <TextView style="@style/GrammarHebrewCell" android:text="אני" />
                        <TextView style="@style/GrammarRussianCell" android:text="я" />
                        <TextView style="@style/GrammarHebrewCell" android:text="אנחנו" />
                        <TextView style="@style/GrammarRussianCell" android:text="мы" />
                    </LinearLayout>

                    <LinearLayout style="@style/GrammarRow">
                        <TextView style="@style/GrammarHebrewCell" android:text="אתה" />
                        <TextView style="@style/GrammarRussianCell" android:text="ты (м.)" />
                        <TextView style="@style/GrammarHebrewCell" android:text="אתם" />
                        <TextView style="@style/GrammarRussianCell" android:text="вы (м.)" />
                    </LinearLayout>

                    <LinearLayout style="@style/GrammarRow">
                        <TextView style="@style/GrammarHebrewCell" android:text="את" />
                        <TextView style="@style/GrammarRussianCell" android:text="ты (ж.)" />
                        <TextView style="@style/GrammarHebrewCell" android:text="אתן" />
                        <TextView style="@style/GrammarRussianCell" android:text="вы (ж.)" />
                    </LinearLayout>

                    <LinearLayout style="@style/GrammarRow">
                        <TextView style="@style/GrammarHebrewCell" android:text="הוא" />
                        <TextView style="@style/GrammarRussianCell" android:text="он" />
                        <TextView style="@style/GrammarHebrewCell" android:text="הם" />
                        <TextView style="@style/GrammarRussianCell" android:text="они (м.)" />
                    </LinearLayout>

                    <LinearLayout style="@style/GrammarRow">
                        <TextView style="@style/GrammarHebrewCell" android:text="היא" />
                        <TextView style="@style/GrammarRussianCell" android:text="она" />
                        <TextView style="@style/GrammarHebrewCell" android:text="הן" />
                        <TextView style="@style/GrammarRussianCell" android:text="они (ж.)" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============= КАРТОЧКА 2: ПРИЛАГАТЕЛЬНЫЕ ============= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Прилагательные (תארים)"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Прилагательное согласуется с существительным и получает окончание."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F5F5F5"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="14dp"
                        android:text="Род / число"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Оконч."
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:text="Пример"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="М.р. ед.ч. (הוא)" />
                    <TextView style="@style/GrammarEndingCell" android:text="—" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדול" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="Ж.р. ед.ч. (היא)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ה" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדולה" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="М.р. мн.ч. (הם)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ים" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדולים" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="Ж.р. мн.ч. (הן)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ות" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדולות" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="גדול — большой"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============= КАРТОЧКА 3: ГЛАГОЛЫ ============= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Глаголы в настоящем времени (פעלים)"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="В настоящем времени глагол меняется как прилагательное — по роду и числу."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F5F5F5"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="14dp"
                        android:text="Кто"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Оконч."
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:text="Пример"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="אני / הוא (м. ед.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="—" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותב" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="אני / היא (ж. ед.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ת" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותבת" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="אנחנו / הם (м. мн.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ים" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותבים" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="אנחנו / הן (ж. мн.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ות" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותבות" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="כותב — пишу / пишет"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#EEEEEE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Инфинитив и предлог"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Инфинитив (שם הפועל) — базовая форма глагола: לכתוב (писать).\n\nПредлог (מילת יחס) — маленькое слово после глагола: ל (к, для). Запоминайте глагол вместе с предлогом."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>