<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="English Grammar"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Шпаргалка по самым важным правилам английского."
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- TO BE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="To be — am / is / are"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Глагол «быть» меняется в зависимости от подлежащего."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="I am" />
                    <TextView style="@style/GrammarRussianCell" android:text="я есть" />
                    <TextView style="@style/GrammarHebrewCell" android:text="we are" />
                    <TextView style="@style/GrammarRussianCell" android:text="мы есть" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="you are" />
                    <TextView style="@style/GrammarRussianCell" android:text="ты/вы есть" />
                    <TextView style="@style/GrammarHebrewCell" android:text="they are" />
                    <TextView style="@style/GrammarRussianCell" android:text="они есть" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="he is" />
                    <TextView style="@style/GrammarRussianCell" android:text="он есть" />
                    <TextView style="@style/GrammarHebrewCell" android:text="she is" />
                    <TextView style="@style/GrammarRussianCell" android:text="она есть" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="it is" />
                    <TextView style="@style/GrammarRussianCell" android:text="оно есть" />
                    <TextView style="@style/GrammarHebrewCell" android:text="" />
                    <TextView style="@style/GrammarRussianCell" android:text="" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Пример: I am a student — Я студент."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PRESENT SIMPLE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Present Simple — простое настоящее"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Используется для обычных, повторяющихся действий. К he/she/it добавляется -s."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="I work" />
                    <TextView style="@style/GrammarRussianCell" android:text="я работаю" />
                    <TextView style="@style/GrammarHebrewCell" android:text="we work" />
                    <TextView style="@style/GrammarRussianCell" android:text="мы работаем" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="you work" />
                    <TextView style="@style/GrammarRussianCell" android:text="ты работаешь" />
                    <TextView style="@style/GrammarHebrewCell" android:text="they work" />
                    <TextView style="@style/GrammarRussianCell" android:text="они работают" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="he works" />
                    <TextView style="@style/GrammarRussianCell" android:text="он работает" />
                    <TextView style="@style/GrammarHebrewCell" android:text="she works" />
                    <TextView style="@style/GrammarRussianCell" android:text="она работает" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Отрицание: I don't work / he doesn't work"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Вопрос: Do you work? / Does he work?"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ARTICLES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Артикли — a / an / the"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Артикль ставится перед существительным. Выбор зависит от звука в начале слова."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="a — перед согласным" />
                    <TextView style="@style/GrammarEndingCell" android:text="" />
                    <TextView style="@style/GrammarExampleCell" android:text="a book" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="an — перед гласным" />
                    <TextView style="@style/GrammarEndingCell" android:text="" />
                    <TextView style="@style/GrammarExampleCell" android:text="an apple" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="the — определённый" />
                    <TextView style="@style/GrammarEndingCell" android:text="" />
                    <TextView style="@style/GrammarExampleCell" android:text="the book" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="a / an — «какой-то, один»; the — «тот самый, известный»."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>