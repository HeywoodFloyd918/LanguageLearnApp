<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hebrew: how words change"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cheat sheet: adjectives and present-tense verbs change by gender and number — just like in English 'he/she' or 'is/are'."
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- PRONOUNS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pronouns"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="These words define gender and number."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="אני" />
                    <TextView style="@style/GrammarRussianCell" android:text="I" />
                    <TextView style="@style/GrammarHebrewCell" android:text="אנחנו" />
                    <TextView style="@style/GrammarRussianCell" android:text="we" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="אתה" />
                    <TextView style="@style/GrammarRussianCell" android:text="you (m.)" />
                    <TextView style="@style/GrammarHebrewCell" android:text="אתם" />
                    <TextView style="@style/GrammarRussianCell" android:text="you pl. (m.)" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="את" />
                    <TextView style="@style/GrammarRussianCell" android:text="you (f.)" />
                    <TextView style="@style/GrammarHebrewCell" android:text="אתן" />
                    <TextView style="@style/GrammarRussianCell" android:text="you pl. (f.)" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="הוא" />
                    <TextView style="@style/GrammarRussianCell" android:text="he" />
                    <TextView style="@style/GrammarHebrewCell" android:text="הם" />
                    <TextView style="@style/GrammarRussianCell" android:text="they (m.)" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="היא" />
                    <TextView style="@style/GrammarRussianCell" android:text="she" />
                    <TextView style="@style/GrammarHebrewCell" android:text="הן" />
                    <TextView style="@style/GrammarRussianCell" android:text="they (f.)" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ADJECTIVES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adjectives (תארים)"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="An adjective agrees with the noun and takes an ending."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F5F5F5"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView style="@style/GrammarDescCell" android:text="Gender / number" />
                    <TextView style="@style/GrammarEndingCell" android:text="Ending" />
                    <TextView style="@style/GrammarExampleCell" android:text="Example" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="M. sg." />
                    <TextView style="@style/GrammarEndingCell" android:text="—" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדול" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="F. sg." />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ה" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדולה" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="M. pl." />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ים" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדולים" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="F. pl." />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ות" />
                    <TextView style="@style/GrammarExampleCell" android:text="גדולות" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="גדול = big"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- VERBS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Present-tense verbs (פעלים)"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="In the present tense a verb changes just like an adjective — by gender and number."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F5F5F5"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView style="@style/GrammarDescCell" android:text="Who" />
                    <TextView style="@style/GrammarEndingCell" android:text="Ending" />
                    <TextView style="@style/GrammarExampleCell" android:text="Example" />
                </LinearLayout>

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="I / he (m. sg.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="—" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותב" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="I / she (f. sg.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ת" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותבת" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="we / they (m. pl.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ים" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותבים" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="we / they (f. pl.)" />
                    <TextView style="@style/GrammarEndingCell" android:text="+ ות" />
                    <TextView style="@style/GrammarExampleCell" android:text="כותבות" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="כותב = write(s)"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>