<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spanish grammar"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cheat sheet for the most important Spanish rules."
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- SER vs ESTAR -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ser vs Estar — two &quot;to be&quot;"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ser — for permanent things. Estar — for temporary states."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="SER"
                    android:textStyle="bold" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="yo soy" />
                    <TextView style="@style/GrammarRussianCell" android:text="I am" />
                    <TextView style="@style/GrammarHebrewCell" android:text="nosotros somos" />
                    <TextView style="@style/GrammarRussianCell" android:text="we are" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="tú eres" />
                    <TextView style="@style/GrammarRussianCell" android:text="you are" />
                    <TextView style="@style/GrammarHebrewCell" android:text="ellos son" />
                    <TextView style="@style/GrammarRussianCell" android:text="they are" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="él/ella es" />
                    <TextView style="@style/GrammarRussianCell" android:text="he/she is" />
                    <TextView style="@style/GrammarHebrewCell" android:text="" />
                    <TextView style="@style/GrammarRussianCell" android:text="" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ESTAR"
                    android:textStyle="bold" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="yo estoy" />
                    <TextView style="@style/GrammarRussianCell" android:text="I am (located)" />
                    <TextView style="@style/GrammarHebrewCell" android:text="nosotros estamos" />
                    <TextView style="@style/GrammarRussianCell" android:text="we are" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="tú estás" />
                    <TextView style="@style/GrammarRussianCell" android:text="you are" />
                    <TextView style="@style/GrammarHebrewCell" android:text="ellos están" />
                    <TextView style="@style/GrammarRussianCell" android:text="they are" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="él/ella está" />
                    <TextView style="@style/GrammarRussianCell" android:text="he/she is" />
                    <TextView style="@style/GrammarHebrewCell" android:text="" />
                    <TextView style="@style/GrammarRussianCell" android:text="" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Example: Soy estudiante — I am a student. Estoy cansado — I am tired."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PRESENTE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Present tense (presente)"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Three groups: -ar, -er, -ir. Endings depend on the group."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="-AR (hablar — to speak)"
                    android:textStyle="bold" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="yo hablo" />
                    <TextView style="@style/GrammarRussianCell" android:text="I speak" />
                    <TextView style="@style/GrammarHebrewCell" android:text="nosotros hablamos" />
                    <TextView style="@style/GrammarRussianCell" android:text="we speak" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="tú hablas" />
                    <TextView style="@style/GrammarRussianCell" android:text="you speak" />
                    <TextView style="@style/GrammarHebrewCell" android:text="ellos hablan" />
                    <TextView style="@style/GrammarRussianCell" android:text="they speak" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="él/ella habla" />
                    <TextView style="@style/GrammarRussianCell" android:text="he/she speaks" />
                    <TextView style="@style/GrammarHebrewCell" android:text="" />
                    <TextView style="@style/GrammarRussianCell" android:text="" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="-ER (comer — to eat)"
                    android:textStyle="bold" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="yo como" />
                    <TextView style="@style/GrammarRussianCell" android:text="I eat" />
                    <TextView style="@style/GrammarHebrewCell" android:text="nosotros comemos" />
                    <TextView style="@style/GrammarRussianCell" android:text="we eat" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="tú comes" />
                    <TextView style="@style/GrammarRussianCell" android:text="you eat" />
                    <TextView style="@style/GrammarHebrewCell" android:text="ellos comen" />
                    <TextView style="@style/GrammarRussianCell" android:text="they eat" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="él/ella come" />
                    <TextView style="@style/GrammarRussianCell" android:text="he/she eats" />
                    <TextView style="@style/GrammarHebrewCell" android:text="" />
                    <TextView style="@style/GrammarRussianCell" android:text="" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="-IR (vivir — to live)"
                    android:textStyle="bold" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="yo vivo" />
                    <TextView style="@style/GrammarRussianCell" android:text="I live" />
                    <TextView style="@style/GrammarHebrewCell" android:text="nosotros vivimos" />
                    <TextView style="@style/GrammarRussianCell" android:text="we live" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="tú vives" />
                    <TextView style="@style/GrammarRussianCell" android:text="you live" />
                    <TextView style="@style/GrammarHebrewCell" android:text="ellos viven" />
                    <TextView style="@style/GrammarRussianCell" android:text="they live" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarHebrewCell" android:text="él/ella vive" />
                    <TextView style="@style/GrammarRussianCell" android:text="he/she lives" />
                    <TextView style="@style/GrammarHebrewCell" android:text="" />
                    <TextView style="@style/GrammarRussianCell" android:text="" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ARTICLES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Articles — el / la / los / las"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="In Spanish every noun has a gender. Articles agree with gender and number."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="el — masculine sg." />
                    <TextView style="@style/GrammarEndingCell" android:text="" />
                    <TextView style="@style/GrammarExampleCell" android:text="el libro" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="la — feminine sg." />
                    <TextView style="@style/GrammarEndingCell" android:text="" />
                    <TextView style="@style/GrammarExampleCell" android:text="la casa" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="los — masculine pl." />
                    <TextView style="@style/GrammarEndingCell" android:text="" />
                    <TextView style="@style/GrammarExampleCell" android:text="los libros" />
                </LinearLayout>
                <LinearLayout style="@style/GrammarRow">
                    <TextView style="@style/GrammarDescCell" android:text="las — feminine pl." />
                    <TextView style="@style/GrammarEndingCell" android:text="" />
                    <TextView style="@style/GrammarExampleCell" android:text="las casas" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Hint: words ending in -o are usually masculine, in -a usually feminine."
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>